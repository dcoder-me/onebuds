<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only removes the old action bar and follows dark mode -->
    <style name="Theme.BudsBattery" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- See-through window: the card draws its own dimmed backdrop and slide-up animation -->
    <style name="Theme.BudsBattery.Popup">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
